# CarlaConfig.cmake — produced by configure_package_config_file().
# Declares Carla::carla-client as an IMPORTED STATIC target backed by the
# LibCarla archive and its installed static dependencies.
#
# Downstream usage:
#
#     find_package(Carla CONFIG REQUIRED)
#     target_link_libraries(myapp PRIVATE Carla::carla-client)
#
@PACKAGE_INIT@

include (CMakeFindDependencyMacro)
find_dependency (Threads)

set_and_check (Carla_INCLUDE_DIR  "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check (Carla_LIBRARY_DIR  "@PACKAGE_CMAKE_INSTALL_LIBDIR@")

if (NOT TARGET Carla::carla-client)
  find_library (Carla_CLIENT_LIBRARY
    NAMES carla-client
    PATHS "${Carla_LIBRARY_DIR}"
    NO_DEFAULT_PATH
    REQUIRED
  )

  set (Carla_STATIC_DEPENDENCY_NAMES
    boost_context
    boost_graph
    boost_random
    boost_serialization
    boost_thread
    boost_date_time
    boost_container
    boost_atomic
    boost_chrono
    boost_filesystem
    Recast
    DetourCrowd
    Detour
    png16
    z
    rpc
  )
  set (Carla_STATIC_DEPENDENCY_LIBRARIES)
  foreach (Carla_DEPENDENCY_NAME IN LISTS Carla_STATIC_DEPENDENCY_NAMES)
    string (MAKE_C_IDENTIFIER
      "${Carla_DEPENDENCY_NAME}" Carla_DEPENDENCY_IDENTIFIER)
    find_library (Carla_${Carla_DEPENDENCY_IDENTIFIER}_LIBRARY
      NAMES ${Carla_DEPENDENCY_NAME}
      PATHS "${Carla_LIBRARY_DIR}"
      NO_DEFAULT_PATH
      REQUIRED
    )
    list (APPEND Carla_STATIC_DEPENDENCY_LIBRARIES
      "${Carla_${Carla_DEPENDENCY_IDENTIFIER}_LIBRARY}")
  endforeach ()

  add_library (Carla::carla-client STATIC IMPORTED)
  set (Carla_INTERFACE_DEFINITIONS "@CARLA_EXPORTED_DEFINITIONS@")
  set_target_properties (Carla::carla-client PROPERTIES
    IMPORTED_LOCATION             "${Carla_CLIENT_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${Carla_INCLUDE_DIR}"
    INTERFACE_COMPILE_DEFINITIONS "${Carla_INTERFACE_DEFINITIONS}"
    INTERFACE_COMPILE_FEATURES    cxx_std_20
    INTERFACE_LINK_LIBRARIES      "${Carla_STATIC_DEPENDENCY_LIBRARIES};Threads::Threads;${CMAKE_DL_LIBS}"
  )
endif ()

check_required_components (Carla)
